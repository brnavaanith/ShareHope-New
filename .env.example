# Copy to .env and fill in — never commit .env
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# MySQL — fill after you start MySQL80 service
# Format: mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/sharehope_db
DATABASE_URL=mysql+pymysql://sharehope:CHANGE_ME@127.0.0.1:3306/sharehope_db

# SMTP via Flask-Mail + Gmail SMTP. Leave blank in dev — app logs emails instead of sending.
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords).
# Gmail accepts either submission transport:
#   587 + MAIL_USE_TLS=true  (STARTTLS — the normal choice)
#   465 + MAIL_USE_SSL=true  (implicit TLS — use this if 587 is blocked)
# If the configured port cannot be reached the app automatically retries the
# other one, so email still works when a firewall blocks 587 (or 465).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=ShareHope <no-reply@example.com>

# AI assistant (Google Gemini). Optional — without it the chatbot answers
# from its built-in ShareHope guide. A Gemini Pro subscription alone does
# NOT grant API access: create a key at Google AI Studio (aistudio.google.com)
# under a project with billing enabled, then paste it below.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash).
GEMINI_MODEL=
